<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Seek</string>
    <key>CFBundleDisplayName</key>
    <string>Seek</string>
    <key>CFBundleIdentifier</key>
    <string>local.seek.app</string>
    <key>CFBundleExecutable</key>
    <string>Seek</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- Menu bar app: no Dock icon, no app switcher entry -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Shown in macOS privacy prompts when Seek first scans these folders -->
    <key>NSDesktopFolderUsageDescription</key>
    <string>Seek indexes file names on your Desktop so you can find them instantly. Nothing leaves your Mac.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Seek indexes file names in Documents so you can find them instantly. Nothing leaves your Mac.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>Seek indexes file names in Downloads so you can find them instantly. Nothing leaves your Mac.</string>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>Seek indexes file names on external drives you choose. Nothing leaves your Mac.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>Seek indexes file names on network drives you choose. Nothing leaves your Mac.</string>
</dict>
</plist>
